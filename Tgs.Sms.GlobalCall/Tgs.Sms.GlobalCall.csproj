<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net5.0</TargetFramework>
    <UserSecretsId>72ea1feb-3fe0-4b79-8d37-b81a7c982537</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
	<GlobalNugetConfig>$(UserProfile)\AppData\Roaming\NuGet\NuGet.Config</GlobalNugetConfig>
	<GlobalNugetConfig Condition="'$(UserProfile)'==''">$(HOME)/.nuget/NuGet/NuGet.Config</GlobalNugetConfig>
	<DockerfileBuildArguments>--build-arg "BuildConfiguration=$(Configuration)" --secret id=nuget,src="$(GlobalNugetConfig)"</DockerfileBuildArguments>
	<DockerfileTag Condition="$(DockerfileTag) == ''">sms-globalcall</DockerfileTag>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.17.0" />
    <PackageReference Include="Tgs.MessageQueue.RabbitMQ" Version="0.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tgs.Sms.GlobalCall.Core\Tgs.Sms.GlobalCall.Core.csproj" />
    <ProjectReference Include="..\Tgs.Sms.GlobalCall.Repositories\Tgs.Sms.GlobalCall.Repositories.csproj" />
  </ItemGroup>

</Project>
